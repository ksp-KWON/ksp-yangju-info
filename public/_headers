# Cloudflare Pages Custom Headers
# W3C & OWASP 글로벌 웹 보안 및 고속 CDN 캐시 정책 (SSOT)

# 1. 전역 보안 헤더 (MIME 스니핑 방어, 클릭재킹 차단, 개인정보 보호)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# 2. 모든 HTML 페이지: 매번 원본 서버에서 최신 버전 재확인 (0초 무지연 반영)
/
  Cache-Control: public, max-age=0, must-revalidate

# 3. 정적 에셋(CSS, JS, 이미지): 고유 해시값을 가지므로 1년 강력 캐싱 (Core Web Vitals 성능 최적화)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
