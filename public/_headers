# Cloudflare Pages Custom Headers
# W3C & OWASP 글로벌 웹 보안 및 고속 CDN 캐시 정책 (SSOT)

# 1. 전역 보안 헤더 및 HTML 무지연 반영 (0초 원본 재확인)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=0, must-revalidate

# 3. 내부 정적 API: 표준 JSON MIME 보장 및 검색엔진 색인 원천 차단
/api/*
  Content-Type: application/json; charset=utf-8
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600, must-revalidate

# 4. 정적 에셋(CSS, JS, 이미지): 고유 해시값을 가지므로 1년 강력 캐싱 (Core Web Vitals 성능 최적화)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
